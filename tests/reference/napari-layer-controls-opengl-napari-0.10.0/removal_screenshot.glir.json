  [
    "DATA",
    72,
    0,
    "uniform mat4 u_matrix;\n\nvec4 affine_transform_map(vec4 pos) {\n    return u_matrix * pos;\n}\n\n\nvec4 transform_map_chain(vec4 pos) {\n    vec4 result_1 = affine_transform_map(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_1(vec4 pos) {\n    vec4 result_1 = transform_map_chain(pos);\n    return result_1;\n}\n\nuniform mat4 u_matrix_1;\n\nvec4 affine_transform_map_1(vec4 pos) {\n    return u_matrix_1 * pos;\n}\n\n\nuniform vec4 u_scale;\nuniform vec4 u_translate;\n\nvec4 st_transform_map(vec4 pos) {\n    return vec4(pos.xyz * u_scale.xyz + u_translate.xyz * pos.w, pos.w);\n}\n\n\nuniform vec4 u_scale_1;\nuniform vec4 u_translate_1;\n\nvec4 st_transform_map_1(vec4 pos) {\n    return vec4(pos.xyz * u_scale_1.xyz + u_translate_1.xyz * pos.w, pos.w);\n}\n\n\nvec4 transform_map_chain_2(vec4 pos) {\n    vec4 result_1 = affine_transform_map_1(pos);\n    vec4 result_2 = st_transform_map(result_1);\n    vec4 result_3 = st_transform_map_1(result_2);\n    return result_3;\n}\n\nvec4 transform_map_chain_3(vec4 pos) {\n    vec4 result_1 = transform_map_chain_2(pos);\n    return result_1;\n}\n\nvec4 null_transform_map(vec4 pos) {return pos;}\n\nvec4 transform_map_chain_4(vec4 pos) {\n    vec4 result_1 = null_transform_map(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_5(vec4 pos) {\n    vec4 result_1 = transform_map_chain_4(pos);\n    return result_1;\n}\n\nuniform vec4 u_scale_2;\nuniform vec4 u_translate_2;\n\nvec4 st_transform_map_2(vec4 pos) {\n    return vec4(pos.xyz * u_scale_2.xyz + u_translate_2.xyz * pos.w, pos.w);\n}\n\n\nuniform vec4 u_scale_3;\nuniform vec4 u_translate_3;\n\nvec4 st_transform_map_3(vec4 pos) {\n    return vec4(pos.xyz * u_scale_3.xyz + u_translate_3.xyz * pos.w, pos.w);\n}\n\n\nvec4 transform_map_chain_6(vec4 pos) {\n    vec4 result_1 = st_transform_map_2(pos);\n    vec4 result_2 = st_transform_map_3(result_1);\n    return result_2;\n}\n\nvec4 transform_map_chain_7(vec4 pos) {\n    vec4 result_1 = transform_map_chain_6(pos);\n    return result_1;\n}\n\nuniform vec4 u_scale_4;\nuniform vec4 u_translate_4;\n\nvec4 st_transform_map_4(vec4 pos) {\n    return vec4(pos.xyz * u_scale_4.xyz + u_translate_4.xyz * pos.w, pos.w);\n}\n\n\nvec4 transform_map_chain_8(vec4 pos) {\n    vec4 result_1 = st_transform_map_4(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_9(vec4 pos) {\n    vec4 result_1 = transform_map_chain_8(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_10(vec4 pos) {\n    vec4 result_1 = transform_map_chain_1(pos);\n    vec4 result_2 = transform_map_chain_3(result_1);\n    vec4 result_3 = transform_map_chain_5(result_2);\n    vec4 result_4 = transform_map_chain_7(result_3);\n    vec4 result_5 = transform_map_chain_9(result_4);\n    return result_5;\n}\n\n\nuniform int method;  // 0=subdivide, 1=impostor\nattribute vec2 a_position;\nattribute vec2 a_texcoord;\nvarying vec2 v_texcoord;\n\nvoid main() {\n    v_texcoord = a_texcoord;\n    gl_Position = transform_map_chain_10(vec4(a_position, 0., 1.));\n}\n\n"
  ],
