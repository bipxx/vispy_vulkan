_transform_imap_2(result_1);\n    return result_2;\n}\n\nvec4 transform_imap_chain_3(vec4 pos) {\n    vec4 result_1 = transform_imap_chain_2(pos);\n    return result_1;\n}\n\nvec4 null_transform_map(vec4 pos) {return pos;}\n\nvec4 transform_imap_chain_4(vec4 pos) {\n    vec4 result_1 = null_transform_map(pos);\n    return result_1;\n}\n\nvec4 transform_imap_chain_5(vec4 pos) {\n    vec4 result_1 = transform_imap_chain_4(pos);\n    return result_1;\n}\n\nuniform vec4 u_scale_8;\nuniform vec4 u_translate_8;\n\nvec4 st_transform_imap_3(vec4 pos) {\n    return vec4((pos.xyz - u_translate_8.xyz * pos.w) / u_scale_8.xyz,\n                pos.w);\n}\n\n\nuniform vec4 u_scale_9;\nuniform vec4 u_translate_9;\n\nvec4 st_transform_imap_4(vec4 pos) {\n    return vec4((pos.xyz - u_translate_9.xyz * pos.w) / u_scale_9.xyz,\n                pos.w);\n}\n\n\nuniform mat4 u_inv_matrix;\n\nvec4 affine_transform_imap(vec4 pos) {\n    return u_inv_matrix * pos;\n}\n\n\nvec4 transform_imap_chain_6(vec4 pos) {\n    vec4 result_1 = st_transform_imap_3(pos);\n    vec4 result_2 = st_transform_imap_4(result_1);\n    vec4 result_3 = affine_transform_imap(result_2);\n    return result_3;\n}\n\nvec4 transform_imap_chain_7(vec4 pos) {\n    vec4 result_1 = transform_imap_chain_6(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain(vec4 pos) {\n    vec4 result_1 = transform_imap_chain_1(pos);\n    vec4 result_2 = transform_imap_chain_3(result_1);\n    vec4 result_3 = transform_imap_chain_5(result_2);\n    vec4 result_4 = transform_imap_chain_7(result_3);\n    return result_4;\n}\n\nvarying vec4 v_position;\n\nvoid clip() {\n    float distance_from_clip = clip_planes(transform_map_chain(v_position).xyz);\n    if (distance_from_clip < 0.)\n        discard;\n}\n\n\nvec4 null_transform_map_1(vec4 pos) {return pos;}\n\nuniform vec4 u_view;\n\nvoid clip_1() {\n    vec4 pos = null_transform_map_1(gl_FragCoord);\n    if( pos.x < u_view.x || pos.x > u_view.y ||\n        pos.y < u_view.z || pos.y > u_view.w ) {\n        discard;\n    }\n}\n\n\n\nvarying vec4 v_color;\nvoid main() {\n    clip();\nclip_1();\n\n\n    gl_FragColor = v_color;\n\n    apply_alpha();\napply_alpha_1();\napply_track_shading();\npicking_filter();\npicking_filter_1();\n\n}\n\n"
