    "uniform mat4 u_matrix;\n\nvec4 affine_transform_map(vec4 pos) {\n    return u_matrix * pos;\n}\n\n\nvec4 transform_map_chain(vec4 pos) {\n    vec4 result_1 = affine_transform_map(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_1(vec4 pos) {\n    vec4 result_1 = transform_map_chain(pos);\n    return result_1;\n}\n\nuniform mat4 u_matrix_1;\n\nvec4 affine_transform_map_1(vec4 pos) {\n    return u_matrix_1 * pos;\n}\n\n\nuniform vec4 u_scale;\nuniform vec4 u_translate;\n\nvec4 st_transform_map(vec4 pos) {\n    return vec4(pos.xyz * u_scale.xyz + u_translate.xyz * pos.w, pos.w);\n}\n\n\nuniform vec4 u_scale_1;\nuniform vec4 u_translate_1;\n\nvec4 st_transform_map_1(vec4 pos) {\n    return vec4(pos.xyz * u_scale_1.xyz + u_translate_1.xyz * pos.w, pos.w);\n}\n\n\nvec4 transform_map_chain_2(vec4 pos) {\n    vec4 result_1 = affine_transform_map_1(pos);\n    vec4 result_2 = st_transform_map(result_1);\n    vec4 result_3 = st_transform_map_1(result_2);\n    return result_3;\n}\n\nvec4 transform_map_chain_3(vec4 pos) {\n    vec4 result_1 = transform_map_chain_2(pos);\n    return result_1;\n}\n\nvec4 null_transform_map(vec4 pos) {return pos;}\n\nvec4 transform_map_chain_4(vec4 pos) {\n    vec4 result_1 = null_transform_map(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_5(vec4 pos) {\n    vec4 result_1 = transform_map_chain_4(pos);\n    return result_1;\n}\n\nuniform vec4 u_scale_2;\nuniform vec4 u_translate_2;\n\nvec4 st_transform_map_2(vec4 pos) {\n    return vec4(pos.xyz * u_scale_2.xyz + u_translate_2.xyz * pos.w, pos.w);\n}\n\n\nuniform vec4 u_scale_3;\nuniform vec4 u_translate_3;\n\nvec4 st_transform_map_3(vec4 pos) {\n    return vec4(pos.xyz * u_scale_3.xyz + u_translate_3.xyz * pos.w, pos.w);\n}\n\n\nvec4 transform_map_chain_6(vec4 pos) {\n    vec4 result_1 = st_transform_map_2(pos);\n    vec4 result_2 = st_transform_map_3(result_1);\n    return result_2;\n}\n\nvec4 transform_map_chain_7(vec4 pos) {\n    vec4 result_1 = transform_map_chain_6(pos);\n    return result_1;\n}\n\nuniform vec4 u_scale_4;\nuniform vec4 u_translate_4;\n\nvec4 st_transform_map_4(vec4 pos) {\n    return vec4(pos.xyz * u_scale_4.xyz + u_translate_4.xyz * pos.w, pos.w);\n}\n\n\nvec4 transform_map_chain_8(vec4 pos) {\n    vec4 result_1 = st_transform_map_4(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_9(vec4 pos) {\n    vec4 result_1 = transform_map_chain_8(pos);\n    return result_1;\n}\n\nvec4 transform_map_chain_10(vec4 pos) {\n    vec4 result_1 = transform_map_chain_1(pos);\n    vec4 result_2 = transform_map_chain_3(result_1);\n    vec4 result_3 = transform_map_chain_5(result_2);\n    vec4 result_4 = transform_map_chain_7(result_3);\n    vec4 result_5 = transform_map_chain_9(result_4);\n    return result_5;\n}\n\nvarying vec4 v_position;\n\nvoid clip() {\n    // pass position as varying for interpolation\n    v_position = gl_Position;\n}\n\n\nattribute float a_a_vertex_time;\nuniform float u_current_time;\nuniform float u_tail_length;\nuniform float u_head_length;\nuniform float u_use_fade;\n\nvarying vec4 v_track_color;\nvoid apply_track_shading() {\n\n    float alpha;\n\n    if (a_a_vertex_time > u_current_time + u_head_length) {\n        // this is a hack to minimize the frag shader rendering ahead\n        // of the current time point due to interpolation\n        // track should cut off sharply at current_time when head length is 0\n        // see #6696 for details\n        if (u_head_length == 0){\n            // this prevents a track from being rendered ahead of the\n            // current time point incorrectly due to the interpolation\n            alpha = -1000.;\n        } else {\n            alpha = 0.;\n        }\n    } else {\n        // fade the track into the temporal distance, scaled by the\n        // maximum tail and head length from the gui\n        float fade = (u_head_length + u_current_time - a_a_vertex_time) / (u_tail_length + u_head_length);\n        alpha = clamp(1.0-fade, 0.0, 1.0);\n    }\n\n    // when use_fade is disabled, the entire track is visible\n    if (u_use_fade == 0) {\n        alpha = 1.0;\n    }\n\n    // set the vertex alpha according to the fade\n    v_track_color.a = alpha;\n}\n\n\n\nvec4 vec3to4(vec3 xyz) {\n    return vec4(xyz, 1.0);\n}\n\n\nattribute vec3 a_position;\nattribute vec4 a_color;\n\nvarying vec4 v_color;\n\nvoid main(void) {\n    gl_Position = transform_map_chain_10(vec3to4(a_position));\n    v_color = a_color;\n\n    clip();\napply_track_shading();\n\n}\n\n"
