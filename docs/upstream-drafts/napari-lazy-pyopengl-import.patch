@@ -1485,3 +1485,14 @@ class VispyCanvas:
     def font_info(self) -> FontInfo:
         """Get the vispy visual for a given overlay."""
         return self._font_info
+
+
+def _gl_errors() -> tuple[type[BaseException], ...]:
+    """Return PyOpenGL's error type if PyOpenGL is in use, without importing it.
+
+    ``context.finish()`` can only raise ``GLError`` through PyOpenGL, which
+    vispy's ``gl+`` backend imports. Importing ``OpenGL.error`` here would load
+    the platform GL library even with vispy builds that do not use PyOpenGL.
+    """
+    error = sys.modules.get('OpenGL.error')
+    return () if error is None else (error.GLError,)
