+import ast
+import inspect
+import sys
+from functools import partial
+
 import numpy as np
 
+from napari._vispy import canvas as canvas_module
+from napari._vispy.canvas import _gl_errors
 from napari.components.overlays import (
     BoundingBoxOverlay,
     CanvasOverlay,
@@ -369,3 +376,60 @@ def test_inserted_layer_receives_shared_world_units_when_units_unchanged(
 
     assert viewer.layers.extent.units == (reg.nm, reg.nm)
     assert canvas.layer_to_visual[image_um].world_units == (reg.nm, reg.nm)
+
+
+def _raise(error):
+    raise error
+
+
+class _RecordImports:
+    """A meta path finder that records attempts to import ``OpenGL.error``."""
+
+    def __init__(self):
+        self.attempts = []
+
+    def find_spec(self, name, path=None, target=None):
+        if name == 'OpenGL.error':
+            self.attempts.append(name)
+
+
+def test_canvas_has_no_module_level_opengl_import():
+    tree = ast.parse(inspect.getsource(canvas_module))
+    top = {
+        node.module or ''
+        for node in tree.body
+        if isinstance(node, ast.ImportFrom)
+    }
+    top |= {
+        alias.name
+        for node in tree.body
+        if isinstance(node, ast.Import)
+        for alias in node.names
+    }
+    assert not {name for name in top if name.split('.')[0] == 'OpenGL'}
+
+
+def test_gl_errors_returns_pyopengl_error():
+    from OpenGL.error import GLError
+
+    assert _gl_errors() == (GLError,)
+
+
+def test_gl_errors_does_not_import_pyopengl(monkeypatch):
+    # Without vispy's PyOpenGL backend, OpenGL.error is not imported; asking
+    # for the error types must not import it (and load the GL library).
+    recorder = _RecordImports()
+    monkeypatch.delitem(sys.modules, 'OpenGL.error', raising=False)
+    monkeypatch.setattr(sys, 'meta_path', [recorder, *sys.meta_path])
+    assert _gl_errors() == ()
+    assert recorder.attempts == []
+
+
+def test_layer_removal_still_suppresses_gl_error(qt_viewer, monkeypatch):
+    from OpenGL.error import GLError
+
+    layer = qt_viewer.viewer.add_points([[0, 0]])
+    context = qt_viewer.canvas._scene_canvas.context
+    error = GLError(err=1282, baseOperation='glFinish')
+    monkeypatch.setattr(context, 'finish', partial(_raise, error))
+    qt_viewer.viewer.layers.remove(layer)  # must not raise
