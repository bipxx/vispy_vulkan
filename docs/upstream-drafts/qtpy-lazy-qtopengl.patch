diff --git a/tests/test_qtgui.py b/tests/test_qtgui.py
index ed5dd4b..8ff2c1a 100644
--- a/tests/test_qtgui.py
+++ b/tests/test_qtgui.py
@@ -1,17 +1,23 @@
 """Test QtGui."""
 
+import os
+import subprocess
 import sys
+from importlib import import_module
 
 import pytest
 
 from qtpy import (
+    API_NAME,
     PYQT5,
+    PYQT6,
     PYQT_VERSION,
     PYSIDE2,
     PYSIDE6,
     QT_VERSION,
     QtCore,
     QtGui,
+    QtModuleNotInstalledError,
     QtWidgets,
     _parse_version,
 )
@@ -246,3 +252,66 @@ def test_opengl_imports():
 def test_theme_icon_enum():
     """Test `QIcon.ThemeIcon` presence and work."""
     QtGui.QIcon.fromTheme(QtGui.QIcon.ThemeIcon.AddressBookNew)
+
+
+requires_qt6 = pytest.mark.skipif(
+    not (PYQT6 or PYSIDE6),
+    reason="Only Qt6 bindings keep the QOpenGL* classes outside QtGui",
+)
+
+
+def _run_child(code):
+    """Run `code` in a fresh interpreter with the current Qt API."""
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        check=True,
+        env=os.environ.copy(),
+    )
+    return result.stdout.strip()
+
+
+def _raise_import_error(name):
+    raise ImportError(name)
+
+
+@requires_qt6
+def test_qtgui_import_defers_qtopengl():
+    """Importing QtGui and QtWidgets does not import Qt6's OpenGL modules."""
+    loaded = _run_child(
+        "import sys, qtpy.QtGui, qtpy.QtWidgets; "
+        "print(sorted(m for m in sys.modules "
+        "if m.endswith(('.QtOpenGL', '.QtOpenGLWidgets'))))",
+    )
+    assert loaded == "[]"
+
+
+@requires_qt6
+def test_qopengl_names_resolve_on_first_access():
+    """QOpenGL* names still resolve from QtGui, from the binding's QtOpenGL."""
+    opengl = import_module(f"{API_NAME}.QtOpenGL")
+    assert QtGui.QOpenGLBuffer is opengl.QOpenGLBuffer
+    assert QtGui.QAbstractOpenGLFunctions is opengl.QAbstractOpenGLFunctions
+
+
+def test_unknown_qopengl_name_raises_attribute_error():
+    """An unknown QOpenGL* name is still an AttributeError."""
+    with pytest.raises(AttributeError):
+        QtGui.QOpenGLNoSuchClass  # noqa: B018
+
+
+@requires_qt6
+def test_missing_qtopengl_raises_module_not_installed(monkeypatch):
+    """A binding without QtOpenGL reports the missing module on access."""
+    monkeypatch.delitem(vars(QtGui), "QOpenGLBuffer", raising=False)
+    monkeypatch.setattr(QtGui, "import_module", _raise_import_error)
+    with pytest.raises(QtModuleNotInstalledError):
+        QtGui.QOpenGLBuffer  # noqa: B018
+
+
+@requires_qt6
+def test_star_import_on_qt6_omits_qopengl_names():
+    """`from qtpy.QtGui import *` no longer copies QOpenGL* names on Qt6."""
+    code = "from qtpy.QtGui import *; print('QOpenGLBuffer' in dir())"
+    assert _run_child(code) == "False"
