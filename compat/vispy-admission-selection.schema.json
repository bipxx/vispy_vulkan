{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "manifest_sha256",
    "candidate",
    "execution_map",
    "requested",
    "closure"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "phase": {
      "const": "admission-selection"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "candidate": {
      "$ref": "#/$defs/scope_ref"
    },
    "execution_map": {
      "$ref": "#/$defs/scope_ref"
    },
    "requested": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "closure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/destination"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "scope_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "profile",
        "criterion"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "criterion": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
