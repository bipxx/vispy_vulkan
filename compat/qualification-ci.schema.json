{
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "repository",
        "reruns",
        "collector_sha256",
        "workflows"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "required-ci-policy"
        },
        "repository": {
          "const": "bipxx/vispy_vulkan"
        },
        "reruns": {
          "const": "latest-complete-attempt-per-workflow-no-mixing"
        },
        "collector_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "job_key",
              "jobs"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "job_key": {
                "type": "string",
                "minLength": 1
              },
              "jobs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "repository",
        "run_id",
        "attempt",
        "job_key",
        "job_name",
        "event",
        "source_head",
        "checked_head",
        "parents",
        "workflow",
        "collector_sha256"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "ci-job-identity"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "job_key": {
          "type": "string",
          "minLength": 1
        },
        "job_name": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "enum": [
            "pull_request",
            "push",
            "workflow_dispatch"
          ]
        },
        "source_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checked_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "parents": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "collector_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "repository",
        "qualification_head",
        "policy_sha256",
        "runs",
        "run_history"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "required-ci-evidence"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "qualification_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workflow",
              "run_id",
              "attempt",
              "run",
              "jobs",
              "identities"
            ],
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "run_id": {
                "type": "integer",
                "minimum": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "run": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "jobs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "identities": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "job_id",
                    "report"
                  ],
                  "properties": {
                    "job_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "report": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "run_history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
