{
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "windows_sdk_sha256",
        "windows_compiler_sha256",
        "windows_scope",
        "linux_scope",
        "metal_scope"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "producer-prerequisite-policy"
        },
        "windows_sdk_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "windows_compiler_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "windows_scope": {
          "const": "vendor-sdk-reuse-only-native-leaf-admission-pending"
        },
        "linux_scope": {
          "const": "blocked-experimental-producer"
        },
        "metal_scope": {
          "const": "experimental-no-hardware-admission"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "candidate",
        "profile",
        "wheel",
        "native_outputs"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "archive-prerequisite"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "scope_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "scope_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "native_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "file"
            ],
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "manifest",
        "dependency_lock",
        "consumer"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "vendor-sdk-reuse"
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "dependency_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
