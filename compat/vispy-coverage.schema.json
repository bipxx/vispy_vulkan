{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "route",
    "manifest_sha256",
    "candidate",
    "origin_dispositions",
    "criteria",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "phase": {
      "const": "proposal"
    },
    "route": {
      "const": "add-required-scoped-retain-parents"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "scope_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "origin_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parent"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Criterion coverage proposal v1; no transfer, receipt or qualification",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "profile"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "profile",
        "origin_sha256",
        "disposition",
        "criteria",
        "proposed_subsets"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "origin_sha256": {
          "$ref": "#/$defs/hash"
        },
        "disposition": {
          "const": "retained-required"
        },
        "criteria": {
          "$ref": "#/$defs/names"
        },
        "proposed_subsets": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "origin_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "profile",
        "criterion"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "criterion": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeid",
        "cases",
        "source"
      ],
      "properties": {
        "nodeid": {
          "$ref": "#/$defs/text"
        },
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "feature",
        "kind",
        "operations",
        "values",
        "requirements",
        "expected",
        "fixture",
        "origin_links",
        "new_requirement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "feature": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "ordinary",
            "mutation",
            "failure",
            "recovery"
          ]
        },
        "operations": {
          "$ref": "#/$defs/names"
        },
        "values": {
          "$ref": "#/$defs/text"
        },
        "requirements": {
          "$ref": "#/$defs/names"
        },
        "expected": {
          "$ref": "#/$defs/text"
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "origin_links": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/origin_link"
          }
        },
        "new_requirement": {
          "type": "boolean"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "profile",
        "status",
        "workflow",
        "scenario",
        "rationale"
      ],
      "properties": {
        "criterion": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "script-ready",
            "source-only"
          ]
        },
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "script",
            "arguments",
            "injection"
          ],
          "properties": {
            "script": {
              "$ref": "#/$defs/file"
            },
            "arguments": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string"
              }
            },
            "injection": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
