{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisPy compatibility ledger version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "upstream_commit", "reviewed", "scope", "related_inventories", "capabilities", "profiles", "applicability", "features", "rows"],
  "properties": {
    "schema": {"const": 2},
    "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed": {"type": "boolean"},
    "scope": {"type": "string", "minLength": 1},
    "related_inventories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "capabilities": {"$ref": "#/$defs/names"},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "applicability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicability"}},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "admitted", "environment_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"},
        "admitted": {"type": "boolean"},
        "environment_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entry_point", "upstream_sources", "requirements", "capabilities", "scope_reason", "ordinary", "mutation", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "entry_point": {"$ref": "#/$defs/text"},
        "upstream_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "capabilities": {"$ref": "#/$defs/names"}, "scope_reason": {"$ref": "#/$defs/text"},
        "ordinary": {"$ref": "#/$defs/text"}, "mutation": {"$ref": "#/$defs/text"},
        "owner": {"enum": ["coordinator", "python-hosts", "native", "packaging-proof"]}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["feature", "profile", "status", "rationale", "reviewed", "dependencies"],
      "properties": {
        "feature": {"$ref": "#/$defs/id"}, "profile": {"$ref": "#/$defs/id"},
        "status": {"enum": ["required", "optional", "not-applicable"]},
        "rationale": {"$ref": "#/$defs/text"}, "reviewed": {"type": "boolean"},
        "dependencies": {"$ref": "#/$defs/names"}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scenario", "binding", "script", "arguments"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "scenario": {"enum": ["headless", "qt", "script"]},
        "binding": {"enum": [null, "pyqt5", "pyqt6", "pyside6"]},
        "script": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}
        },
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "identity": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["source_commit", "patch_sha256", "profile_sha256", "wheel_sha256"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "patch_sha256": {"$ref": "#/$defs/hash"}, "profile_sha256": {"$ref": "#/$defs/hash"},
        "wheel_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeid", "kind", "expected", "cases"],
      "properties": {
        "nodeid": {"$ref": "#/$defs/text"}, "kind": {"enum": ["ordinary", "mutation"]},
        "expected": {"$ref": "#/$defs/text"}, "cases": {"type": "integer", "minimum": 1}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["feature", "profile", "state", "outcome", "fixtures", "identity", "receipt", "blocker", "next_action"],
      "properties": {
        "feature": {"$ref": "#/$defs/id"}, "profile": {"$ref": "#/$defs/id"},
        "workflow": {"$ref": "#/$defs/workflow"},
        "state": {"enum": ["not-inventoried", "unsupported", "implemented-untested", "source-tested", "wheel-tested", "qualified", "blocked-external"]},
        "outcome": {"enum": ["not-run", "passed", "failed", "blocked"]},
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
        "identity": {"$ref": "#/$defs/identity"},
        "receipt": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}
        },
        "blocker": {"$ref": "#/$defs/text"}, "next_action": {"$ref": "#/$defs/text"}
      }
    }
  }
}
