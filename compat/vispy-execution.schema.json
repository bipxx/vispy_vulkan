{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "manifest_sha256",
    "candidate",
    "coverage",
    "baseline",
    "execution",
    "mappings"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "phase": {
      "const": "execution-preparation"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "candidate": {
      "$ref": "#/$defs/scope_ref"
    },
    "coverage": {
      "$ref": "#/$defs/file"
    },
    "baseline": {
      "$ref": "#/$defs/file"
    },
    "execution": {
      "$ref": "#/$defs/scope_ref"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "scope_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "profile",
        "criterion"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "criterion": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "profile",
        "destination",
        "workflow"
      ],
      "properties": {
        "criterion": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "workflow": {
          "$ref": "#/$defs/id"
        },
        "functional_result": {
          "$ref": "#/$defs/functional_binding"
        }
      }
    },
    "functional_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract",
        "branch_ids"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "contract": {
          "enum": ["tk-state-resource-1", "tk-capture-1"]
        },
        "branch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
